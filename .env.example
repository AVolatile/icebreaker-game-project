# Combined local app: npm run dev; phones on the same LAN can join.
PORT=4310
# Optional fixed LAN origin. Automatic discovery otherwise.
# PUBLIC_APP_URL=http://192.168.1.20:4310

# Netlify frontend: public values baked in at build time. No secrets here.
# VITE_REALTIME_URL=https://your-ruckus-realtime.onrender.com
# VITE_PUBLIC_APP_URL=https://your-ruckus.netlify.app

# Persistent Render service: set these in the provider dashboard.
# NODE_ENV=production
# REALTIME_ONLY=true
# CLIENT_ORIGIN=https://your-ruckus.netlify.app
# PUBLIC_APP_URL=https://your-ruckus.netlify.app
# ALLOWED_ORIGINS=https://a-specific-preview.netlify.app
# PORT is supplied by Render. Do not set it there.
